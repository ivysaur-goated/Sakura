<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Sakura Japan Tours</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap">
<style>
/* Layout: one long client page. Packages first, an expandable trip detail (pictures, destinations, itinerary), then a five-step booking flow with a live price summary, then About and Contact. */
:root {
  --bg: #fbf4f1;
  --fg: #2e1f26;
  --muted: #6c5560;
  --panel: #f6e0e7;
  --panel-2: #fff9f7;
  --line: #e7cfd6;
  --red: #b8322b;
  --red-ink: #b8322b;
  --rose: #d98aa5;
  --rose-ink: #a3416a;
  --gold: #c9a56a;
  --gold-ink: #86672a;
  --on-red: #ffffff;
  --err: #a8200f;
  --font-display: "Shippori Mincho", "Hiragino Mincho ProN", "Yu Mincho", Georgia, serif;
  --font-body: "Zen Kaku Gothic New", "Hiragino Sans", "Yu Gothic", system-ui, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #1b1217; --fg: #f5e8ec; --muted: #c2aab4; --panel: #2a1b23; --panel-2: #231720; --line: #43303a;
    --red: #d9473e; --red-ink: #f08377; --rose: #d98aa5; --rose-ink: #eba6bd; --gold: #c9a56a; --gold-ink: #dbbb80;
    --on-red: #ffffff; --err: #ff9a8c; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #1b1217; --fg: #f5e8ec; --muted: #c2aab4; --panel: #2a1b23; --panel-2: #231720; --line: #43303a;
  --red: #d9473e; --red-ink: #f08377; --rose: #d98aa5; --rose-ink: #eba6bd; --gold: #c9a56a; --gold-ink: #dbbb80;
  --on-red: #ffffff; --err: #ff9a8c; color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
body {
  background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 17px; line-height: 1.6;
  padding-block: 0 48px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 30; background: var(--bg); }
.wrap { max-width: 1120px; margin-inline: auto; }
h1, h2, h3 { font-family: var(--font-display); font-weight: 800; line-height: 1.12; margin: 0; text-wrap: balance; }
h1 { font-size: clamp(2.3rem, 5.6vw, 4rem); letter-spacing: -0.01em; }
h2 { font-size: clamp(1.7rem, 3.4vw, 2.5rem); }
h3 { font-size: 1.3rem; font-weight: 700; }
p { margin: 0; }
:focus-visible { outline: 3px solid var(--rose-ink); outline-offset: 3px; border-radius: 6px; }
.eyebrow { font-size: 0.76rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: var(--red-ink); }
.lede { font-size: clamp(1.05rem, 1.6vw, 1.2rem); color: var(--muted); max-width: 60ch; }
section { padding-top: clamp(56px, 8vw, 100px); scroll-margin-top: 70px; }
.section-head { display: grid; gap: 12px; margin-bottom: 32px; max-width: 760px; }
.note { font-size: 0.86rem; color: var(--muted); }

.btn { font: inherit; font-weight: 700; font-size: 0.97rem; background: var(--red); color: var(--on-red); border: 2px solid var(--red); padding: 13px 26px; border-radius: 999px; cursor: pointer; text-decoration: none; display: inline-block; text-align: center; transition: transform .15s ease; }
.btn:hover { transform: translateY(-2px); }
.btn.ghost { background: transparent; color: var(--fg); border-color: var(--line); }
.btn.small { padding: 9px 18px; font-size: 0.9rem; }
.btn[aria-disabled="true"] { opacity: .45; cursor: not-allowed; transform: none; }

/* nav */
.nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: var(--bg); border-bottom: 1px solid var(--line); }
.nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 12px; }
.brand { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; text-decoration: none; }
.brand span { color: var(--rose-ink); margin-left: 8px; font-size: 1.1rem; }
.nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; font-size: 0.92rem; font-weight: 500; }
.nav ul a { text-decoration: none; color: var(--muted); }
.nav ul a:hover { color: var(--fg); }
@media (max-width: 720px) { .nav ul { display: none; } }

/* pictures */
.pic { aspect-ratio: 16 / 10; max-width: 100%; overflow: hidden; background: var(--panel); }
.pic svg { display: block; width: 100%; height: 100%; }
.pic.split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; position: relative; }
.pic.split span { position: absolute; bottom: 10px; font-size: 0.72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; background: rgba(27, 18, 23, .72); color: #fff; padding: 4px 10px; border-radius: 999px; }
.pic.split span:first-of-type { left: 10px; }
.pic.split span:last-of-type { right: 10px; }

/* hero + package cards */
.hero { padding-top: clamp(36px, 6vw, 76px); display: grid; gap: 20px; }
.hero h1 { max-width: 18ch; }
.cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 20px; }
.card { background: var(--panel); border-radius: 24px; overflow: hidden; display: grid; grid-template-rows: auto 1fr; border: 2px solid transparent; min-width: 0; }
.card.open { border-color: var(--red); }
.card .body { padding: 22px; display: grid; gap: 12px; align-content: start; grid-template-rows: auto auto 1fr auto; }
.card .cat { font-size: 0.76rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; }
.card.c-red .cat { color: var(--red-ink); } .card.c-rose .cat { color: var(--rose-ink); } .card.c-gold .cat { color: var(--gold-ink); }
.card .where { color: var(--muted); font-size: 0.92rem; }
.card p.d { color: var(--muted); font-size: 0.97rem; line-height: 1.5; }
.card .foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-top: 14px; border-top: 1px solid var(--line); }
.card .price { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; font-variant-numeric: tabular-nums; }
.card .price small { display: block; font-family: var(--font-body); font-weight: 400; font-size: 0.74rem; color: var(--muted); }
.chip { font-weight: 700; font-size: 0.85rem; background: var(--bg); padding: 5px 12px; border-radius: 999px; white-space: nowrap; }
@media (max-width: 960px) { .cards { grid-template-columns: minmax(0, 1fr); } }

/* trip detail */
.detail { margin-top: 28px; background: var(--panel-2); border: 1px solid var(--line); border-radius: 28px; padding: clamp(20px, 4vw, 44px); display: grid; gap: 30px; scroll-margin-top: 80px; }
.detail[hidden] { display: none; }
.dhead { display: flex; justify-content: space-between; align-items: start; gap: 16px; flex-wrap: wrap; }
.dhead .t { display: grid; gap: 8px; }
.dhead h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chips .chip { background: var(--panel); }
.seg { display: flex; flex-wrap: wrap; gap: 8px; }
.seg button { font: inherit; font-weight: 700; font-size: 0.92rem; padding: 10px 18px; border-radius: 999px; border: 2px solid var(--line); background: transparent; color: var(--fg); cursor: pointer; }
.seg button[aria-pressed="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
.banner { aspect-ratio: 21 / 9; border-radius: 20px; }
@media (max-width: 640px) { .banner { aspect-ratio: 16 / 10; } }
.dtext { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 28px; align-items: start; }
.dtext p { color: var(--muted); font-size: 1.05rem; max-width: 60ch; }
.hl { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
.hl li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 12px; align-items: start; font-size: 0.97rem; }
.hl li::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--rose); margin-top: 8px; }
@media (max-width: 800px) { .dtext { grid-template-columns: minmax(0, 1fr); } }
.sub { display: grid; gap: 6px; }
.sub h3 { font-size: 1.5rem; }
.dests { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 18px; }
.dest { border-radius: 18px; overflow: hidden; background: var(--panel); display: grid; grid-template-rows: auto 1fr; min-width: 0; }
.dest .tx { padding: 16px 18px 20px; display: grid; gap: 4px; align-content: start; }
.dest h4 { margin: 0; font-family: var(--font-display); font-size: 1.2rem; }
.dest p { color: var(--muted); font-size: 0.94rem; line-height: 1.5; }
.days-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 16px; }
.day { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--bg); display: grid; grid-template-rows: auto 1fr; min-width: 0; }
.day .pic { aspect-ratio: 16 / 7; }
.day .in { padding: 14px 16px 18px; display: grid; gap: 10px; align-content: start; }
.day header { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; border-bottom: 1px solid var(--line); padding-bottom: 8px; }
.day .dn { font-size: 0.74rem; letter-spacing: .14em; font-weight: 700; text-transform: uppercase; color: var(--red-ink); white-space: nowrap; }
.day .loc { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; text-align: right; }
.day ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; font-size: 0.92rem; color: var(--muted); }
.day li::marker { color: var(--rose); }
.dfoot { display: flex; gap: 12px; flex-wrap: wrap; justify-content: space-between; align-items: center; padding-top: 6px; border-top: 1px solid var(--line); }

/* booking */
.progress { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; margin: 0 0 28px; padding: 0; }
.progress li { border-top: 3px solid var(--line); padding-top: 8px; font-size: 0.82rem; font-weight: 700; color: var(--muted); display: grid; }
.progress li span { font-size: 0.7rem; letter-spacing: .12em; text-transform: uppercase; }
.progress li.done { border-color: var(--rose); color: var(--fg); }
.progress li.now { border-color: var(--red); color: var(--fg); }
@media (max-width: 600px) { .progress li b { display: none; } }
.app { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 32px; align-items: start; }
@media (max-width: 900px) { .app { grid-template-columns: minmax(0, 1fr); } }
.step { display: grid; gap: 22px; }
.step[hidden] { display: none; }
.step > h3 { font-size: 1.5rem; }
.trips { display: grid; gap: 14px; }
.trip { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 16px; align-items: start; text-align: left; background: var(--panel); border: 2px solid transparent; border-radius: 18px; padding: 18px 20px; cursor: pointer; font: inherit; color: inherit; width: 100%; }
.trip[aria-checked="true"] { border-color: var(--red); background: var(--panel-2); }
.radio { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--muted); margin-top: 4px; display: grid; place-items: center; }
[aria-checked="true"] > .radio { border-color: var(--red); }
[aria-checked="true"] > .radio::after { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--red); }
.trip .meta { font-size: 0.76rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; }
.trip h4 { margin: 0; font-family: var(--font-display); font-size: 1.2rem; }
.trip .where { color: var(--muted); font-size: 0.92rem; }
.trip .pr { text-align: right; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
.trip .pr small { display: block; font-family: var(--font-body); font-weight: 400; font-size: 0.74rem; color: var(--muted); }
.trip .tx { display: grid; gap: 2px; min-width: 0; }
.trip.c-red .meta { color: var(--red-ink); } .trip.c-rose .meta { color: var(--rose-ink); } .trip.c-gold .meta { color: var(--gold-ink); }
@media (max-width: 520px) { .trip { grid-template-columns: 22px minmax(0, 1fr); } .trip .pr { grid-column: 2; text-align: left; } }
.field { display: grid; gap: 6px; min-width: 0; }
.field label, .field .lbl { font-size: 0.85rem; font-weight: 700; }
.hint { font-size: 0.82rem; color: var(--muted); }
input[type="text"], input[type="email"], input[type="tel"], select, textarea { font: inherit; color: var(--fg); background: var(--panel-2); border: 2px solid var(--line); border-radius: 12px; padding: 12px 14px; width: 100%; min-width: 0; }
textarea { resize: vertical; min-height: 84px; }
input:focus, select:focus, textarea:focus { border-color: var(--rose-ink); outline: none; }
.field.bad input, .field.bad select { border-color: var(--err); }
.err { color: var(--err); font-size: 0.84rem; font-weight: 500; }
.row2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
@media (max-width: 560px) { .row2 { grid-template-columns: minmax(0, 1fr); } }
.stepper { display: inline-flex; align-items: center; border: 2px solid var(--line); border-radius: 999px; background: var(--panel-2); width: max-content; }
.stepper button { width: 46px; height: 46px; border: 0; background: transparent; font: inherit; font-size: 1.4rem; color: var(--fg); cursor: pointer; border-radius: 50%; }
.stepper button:disabled { opacity: .3; cursor: default; }
.stepper output { min-width: 40px; text-align: center; font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; font-variant-numeric: tabular-nums; }
.seats { display: flex; gap: 5px; flex-wrap: wrap; }
.seats i { width: 14px; height: 14px; border-radius: 50%; background: var(--line); display: block; }
.seats i.mine { background: var(--red); }
.actions { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; justify-content: space-between; padding-top: 8px; }

.rooms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.room { text-align: left; font: inherit; color: inherit; cursor: pointer; background: var(--panel); border: 2px solid transparent; border-radius: 16px; padding: 16px 18px; display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 14px; align-items: start; }
.room[aria-checked="true"] { border-color: var(--red); background: var(--panel-2); }
.room b { display: block; }
.room span.s { color: var(--muted); font-size: 0.9rem; display: block; }
@media (max-width: 560px) { .rooms { grid-template-columns: minmax(0, 1fr); } }
.opts { display: grid; gap: 12px; }
.opt { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; gap: 14px; align-items: start; background: var(--panel); border-radius: 16px; padding: 16px 18px; }
.opt input[type="checkbox"] { width: 22px; height: 22px; margin: 2px 0 0; accent-color: var(--red); }
.opt label { font-weight: 700; display: block; cursor: pointer; }
.opt .s { color: var(--muted); font-size: 0.9rem; font-weight: 400; display: block; }
.opt .amt { font-family: var(--font-display); font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; text-align: right; }
.opt .amt small { display: block; font-family: var(--font-body); font-weight: 400; font-size: 0.74rem; color: var(--muted); }
.opt .sel { margin-top: 10px; display: flex; align-items: center; gap: 10px; font-size: 0.9rem; }
.opt .sel select { width: auto; padding: 8px 12px; }
@media (max-width: 520px) { .opt { grid-template-columns: 26px minmax(0, 1fr); } .opt .amt { grid-column: 2; text-align: left; } }

.review { background: var(--panel); border-radius: 18px; padding: 22px; }
.review dl { margin: 0; display: grid; grid-template-columns: minmax(0, 140px) minmax(0, 1fr); gap: 10px 16px; font-size: 0.97rem; }
.review dt { color: var(--muted); }
.review dd { margin: 0; font-weight: 500; overflow-wrap: anywhere; }
.pay { border: 2px solid var(--fg); border-radius: 18px; padding: 22px; display: grid; gap: 14px; }
.pay .due { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.pay .due b { font-family: var(--font-display); font-size: 2rem; font-variant-numeric: tabular-nums; }
.notice { background: var(--panel); border-left: 4px solid var(--gold); padding: 12px 14px; border-radius: 8px; font-size: 0.9rem; }
.notice[hidden] { display: none; }

.sum { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 76px); background: var(--panel); border-radius: 22px; padding: 24px; display: grid; gap: 16px; }
@media (max-width: 900px) { .sum { position: static; } }
.sum h3 { font-size: 1.2rem; }
.sum .name { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; line-height: 1.15; }
.sum .lines { display: grid; gap: 8px; font-size: 0.95rem; }
.sum .ln { display: flex; justify-content: space-between; gap: 12px; }
.sum .ln span:first-child { color: var(--muted); }
.sum .ln span:last-child { text-align: right; font-variant-numeric: tabular-nums; }
.sum hr { border: 0; border-top: 1px solid var(--line); margin: 0; width: 100%; }
.sum .tot { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.sum .tot b { font-family: var(--font-display); font-size: 1.3rem; font-variant-numeric: tabular-nums; text-align: right; }
.sum .empty { color: var(--muted); font-size: 0.95rem; }
.incl { margin: 0; padding-left: 18px; font-size: 0.88rem; color: var(--muted); display: grid; gap: 3px; }
.incl li::marker { color: var(--rose); }

/* about + contact */
.about { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
@media (max-width: 860px) { .about { grid-template-columns: minmax(0, 1fr); } }
.about .copy { display: grid; gap: 18px; }
.about .copy p { color: var(--muted); max-width: 58ch; }
.compare { background: var(--panel); border-radius: 24px; padding: 28px; display: grid; gap: 22px; }
.crow { display: grid; gap: 10px; }
.crow .lab { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 0.8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.crow .lab b { font-family: var(--font-display); font-size: 1.5rem; letter-spacing: 0; text-transform: none; color: var(--fg); }
.dots { display: flex; flex-wrap: wrap; gap: 6px; }
.dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--line); display: block; }
.dots.s i { width: 20px; height: 20px; background: var(--red); }
.dots.s i:nth-child(3n+2) { background: var(--rose); }
.dots.s i:nth-child(5n) { background: var(--gold); }
.values { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 36px; }
.val { border-top: 2px solid var(--fg); padding-top: 16px; display: grid; gap: 6px; }
.val h3 { font-size: 1.2rem; }
.val p { color: var(--muted); font-size: 0.96rem; }
@media (max-width: 760px) { .values { grid-template-columns: minmax(0, 1fr); } }
.contact { background: var(--fg); color: var(--bg); border-radius: 28px; padding: clamp(28px, 5vw, 60px); display: grid; gap: 18px; position: relative; overflow: hidden; }
.contact .kanji { position: absolute; right: 12px; top: -30px; font-family: var(--font-display); font-weight: 800; font-size: 14rem; line-height: 1; color: var(--rose); opacity: .2; pointer-events: none; user-select: none; }
.contact > * { position: relative; }
.contact .eyebrow { color: var(--gold); }
.contact p { max-width: 52ch; opacity: .88; }
.cgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 18px; padding-top: 6px; }
.citem { display: grid; gap: 2px; }
.citem span.l { font-size: 0.74rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--gold); }
.citem b { font-family: var(--font-display); font-size: 1.4rem; overflow-wrap: anywhere; user-select: all; }
.contact .btn { justify-self: start; background: var(--rose); border-color: var(--rose); color: #2e1f26; }
footer { padding-top: 36px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; color: var(--muted); font-size: 0.88rem; }
</style>

<header class="nav">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="Sakura home">Sakura <span aria-hidden="true">桜</span></a>
    <nav aria-label="Primary">
      <ul>
        <li><a href="#packages">Trips</a></li>
        <li><a href="#book">Book</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
    <a class="btn small" href="#book">Book a trip</a>
  </div>
</header>

<main class="wrap" id="top">

