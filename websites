  }
  $("paybtn").addEventListener("click", function (e) { if (this.getAttribute("aria-disabled") === "true") e.preventDefault(); });
  document.addEventListener("click", function (e) {
    var nx = e.target.closest("[data-next]"), bk = e.target.closest("[data-back]");
    if (nx) { var n = +nx.getAttribute("data-next"); if (validate(n)) show(n + 1, true); }
    if (bk) show(+bk.getAttribute("data-back") - 1, true);
  });
  $("form").addEventListener("submit", function (e) { e.preventDefault(); });

  /* ---------- about + contact ---------- */
  function fillDots(id, n) { var s = ""; for (var i = 0; i < n; i++) s += "<i></i>"; $(id).innerHTML = s; }
  fillDots("d-coach", 45); fillDots("d-sak", 12);
  (function () {
    var h = '<div class="citem"><span class="l">Contact</span><b>' + esc(CONTACT.name) + (CONTACT.role ? " · " + esc(CONTACT.role) : "") + "</b></div>";
    if (CONTACT.email) h += '<div class="citem"><span class="l">Email</span><b>' + esc(CONTACT.email) + "</b></div>";
    if (CONTACT.phone) h += '<div class="citem"><span class="l">Phone</span><b>' + esc(CONTACT.phone) + "</b></div>";
    if (!CONTACT.email && !CONTACT.phone) h += '<div class="citem"><span class="l">Email and phone</span><b>Coming soon</b></div>';
    $("cgrid").innerHTML = h;
  })();

  renderCards(); renderTrips(); renderSeason(); renderSummary(); show(1, false);
})();
</script>

</body></html>
